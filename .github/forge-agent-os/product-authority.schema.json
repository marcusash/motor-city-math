{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/product-authority-pointer-v1.json",
  "title": "Forge product authority pointer",
  "type": "object",
  "required": ["schemaVersion", "product", "pointer"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "pointer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|[/\\\\]|.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    }
  }
}
