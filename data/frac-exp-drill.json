      "type": "fractional-exp",
      "question_html": "Solve: \\( 4x^{3/2} = 32 \\)",
      "inputs": [
        {
          "id": "q2_x",
          "type": "number",
          "label": "x =",
          "answer": 4,
          "tolerance": 0.01
        }
      ],
      "hint": "Divide by 4 first to isolate x^(3/2). Then raise to 2/3.",
      "solution_steps": [
        "x^(3/2) = 8.",
        "Raise to 2/3: x = 8^(2/3).",
        "8^(1/3) = 2, then 2² = 4.",
        "Check: 4(4)^(3/2) = 4 · 8 = 32 ✓"
      ],
      "feedback_correct": "🔥 8^(2/3) = 4. Clean.",
      "feedback_wrong": "Divide by 4 FIRST. Then raise x^(3/2) to the 2/3 power."
    },
    {
