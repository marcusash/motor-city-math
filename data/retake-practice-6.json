            "rational",
            "exponential"
          ],
          "answer": "quadratic"
        },
        {
          "id": "q1_x1",
          "type": "number",
          "label": "x₁ =",
          "answer": -3,
          "tolerance": 0.1
        },
        {
          "id": "q1_x2",
          "type": "number",
          "label": "x₂ =",
          "answer": 5,
          "tolerance": 0.1
        }
