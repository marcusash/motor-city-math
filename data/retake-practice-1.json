      ],
      "hint": "Rewrite both sides as powers of 2.",
      "solution_steps": [
        "Rewrite: 4 = 2², so 4^(x+1) = 2^(2x+2).",
        "Rewrite: 8 = 2³.",
        "2^(2x+2) = 2³ → 2x + 2 = 3.",
        "2x = 1 → x = 1/2 = 0.5.",
        "Check: 4^(1.5) = (2²)^(1.5) = 2³ = 8 ✓"
      ],
      "feedback_correct": "🔥 Common base. Smooth.",
      "feedback_wrong": "Both 4 and 8 are powers of 2."
    },
