      ],
      "hint": "Rewrite 49 as 7². Set exponents equal.",
      "solution_steps": [
        "Rewrite: 7^(2x-3) = 7².",
        "Set exponents equal: 2x - 3 = 2.",
        "2x = 5 → x = 5/2 = 2.5.",
        "Check: 7^(5-3) = 7² = 49 ✓"
      ],
      "feedback_correct": "🔥 Exponent match. Clean.",
      "feedback_wrong": "Rewrite 49 as a power of 7."
    },
    {
