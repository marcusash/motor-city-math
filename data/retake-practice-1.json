      "type": "quadratic",
      "question_html": "Solve: \\( 3(x - 4)^2 - 12 = 0 \\)",
      "inputs": [
        {
          "id": "q5_x1",
          "type": "number",
          "label": "x₁ =",
          "answer": 6,
          "tolerance": 0.1
