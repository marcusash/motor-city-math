      "question_html": "Solve: \\( \\sqrt{5x - 1} + 2 = 7 \\)",
      "inputs": [
        {
          "id": "q6_x",
          "type": "number",
          "label": "x =",
          "answer": 5.2,
          "tolerance": 0.01
