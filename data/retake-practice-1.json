          "id": "q5_x2",
          "type": "number",
          "label": "x₂ =",
          "answer": 2,
          "tolerance": 0.1
        }
      ],
      "plus_minus": true,
      "hint": "Isolate the squared term. Then ±.",
      "solution_steps": [
        "3(x-4)² = 12 → (x-4)² = 4.",
        "x - 4 = ±2.",
        "x = 4 + 2 = 6 or x = 4 - 2 = 2.",
        "Check: 3(6-4)² - 12 = 3(4) - 12 = 0 ✓"
      ],
      "feedback_correct": "🔥 Both solutions found.",
      "feedback_wrong": "Isolate (x-4)², then take ± square root."
    },
