    {
      "id": "rp1-q1",
      "number": 1,
      "section": "A",
      "standard": "W2.b",
      "type": "identify",
      "question_html": "Identify the parent function and find the x-intercepts: \\( f(x) = 2(x - 3)^2 - 8 \\)",
      "inputs": [
        {
          "id": "q1_parent",
          "type": "dropdown",
          "label": "Parent function",
          "options": [
            "quadratic",
            "cubic",
            "absolute value",
            "square root",
            "rational",
            "exponential"
          ],
          "answer": "quadratic"
        },
        {
          "id": "q1_x1",
          "type": "number",
          "label": "x₁ =",
          "answer": 1,
          "tolerance": 0.1
        },
        {
          "id": "q1_x2",
          "type": "number",
          "label": "x₂ =",
          "answer": 5,
          "tolerance": 0.1
        }
      ],
      "plus_minus": true,
      "hint": "Set f(x)=0. Isolate the squared term.",
      "solution_steps": [
        "Parent: y = x² (quadratic : highest power is 2).",
        "Set 0 = 2(x-3)² - 8.",
        "2(x-3)² = 8 → (x-3)² = 4.",
        "x - 3 = ±2 → x = 5 or x = 1."
      ],
      "feedback_correct": "🔥 Parent and intercepts nailed.",
      "feedback_wrong_parent": "Check the exponent for parent type.",
      "feedback_wrong_intercepts": "Parent right. Set f(x)=0 and solve.",
      "feedback_wrong": "Set f=0: 2(x-3)^2=8 → (x-3)^2=4 → x=1 or 5."
    },
    {
      "id": "rp1-q2",
      "number": 2,
      "section": "A",
      "standard": "W2.b",
      "type": "identify",
      "question_html": "Identify the parent function and find the x-intercept: \\( f(x) = \\sqrt{x + 4} - 3 \\)",
      "inputs": [
        {
          "id": "q2_parent",
          "type": "dropdown",
          "label": "Parent function",
          "options": [
            "quadratic",
            "cubic",
            "absolute value",
            "square root",
            "rational",
            "exponential"
          ],
          "answer": "square root"
        },
        {
          "id": "q2_x1",
          "type": "number",
          "label": "x-intercept =",
          "answer": 5,
          "tolerance": 0.1
        }
      ],
      "hint": "Set f(x)=0. Square both sides.",
      "solution_steps": [
        "Parent: y = √x (square root function).",
        "Set 0 = √(x+4) - 3 → √(x+4) = 3.",
        "Square: x + 4 = 9 → x = 5."
      ],
      "feedback_correct": "🔥 Square root identified. Clean.",
      "feedback_wrong_parent": "Look at the √ symbol.",
      "feedback_wrong": "Isolate: sqrt(x+4)=3. Square: x+4=9 → x=5."
    },
    {
      "id": "rp1-q3",
      "number": 3,
      "section": "A",
      "standard": "W2.b",
      "type": "identify",
      "question_html": "Identify the parent function and describe the transformations: \\( f(x) = -|x - 1| + 4 \\)",
      "inputs": [
        {
          "id": "q3_parent",
          "type": "dropdown",
          "label": "Parent function",
          "options": [
            "quadratic",
            "cubic",
            "absolute value",
            "square root",
            "rational",
