          "label": "Parent function",
          "options": [
            "quadratic",
            "cubic",
            "absolute value",
            "square root",
            "rational",
            "exponential"
          ],
          "answer": "quadratic"
        },
        {
          "id": "q1_x1",
          "type": "number",
          "label": "x₁ =",
          "answer": 3,
          "tolerance": 0.1
        },
        {
          "id": "q1_x2",
          "type": "number",
          "label": "x₂ =",
          "answer": -1,
          "tolerance": 0.1
        }
      ],
      "plus_minus": true,
      "hint": "Set f(x)=0. Isolate the squared term.",
      "solution_steps": [
        "Parent: y = x² (quadratic).",
        "Set 0 = 3(x-1)² - 12 → (x-1)² = 4.",
        "x - 1 = ±2 → x = 3 or x = -1."
      ],
      "feedback_correct": "🔥 Quadratic intercepts. Clean.",
      "feedback_wrong_parent": "Check the exponent for parent type.",
      "feedback_wrong_intercepts": "Parent right. Set f(x)=0 and solve."
