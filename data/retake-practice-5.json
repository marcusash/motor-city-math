            "square root",
            "rational",
            "exponential"
          ],
          "answer": "quadratic"
        },
        {
          "id": "q1_x1",
          "type": "number",
          "label": "x₁ =",
          "answer": 0,
          "tolerance": 0.1
        },
        {
          "id": "q1_x2",
          "type": "number",
          "label": "x₂ =",
          "answer": 6,
          "tolerance": 0.1
        }
      ],
      "hint": "Expand or use the Zero Product Property. What degree is this function?",
      "solution_steps": [
        "Expand: x(x−6) = x² − 6x. Highest power is 2 → parent is quadratic.",
        "Zero Product Property: x = 0 sets first factor to zero.",
        "x − 6 = 0 → x = 6 sets second factor to zero.",
        "Intercepts: x = 0 and x = 6. No ±√ needed — factored form gives roots directly."
      ],
      "feedback_correct": "🔥 Parent and intercepts nailed.",
      "feedback_wrong_parent": "Check the exponent for parent type.",
      "feedback_wrong_intercepts": "Parent right. Set f(x)=0 and solve."
