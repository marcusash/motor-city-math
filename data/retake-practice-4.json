      "id": "rp4-q1",
      "number": 1,
      "section": "A",
      "standard": "W2.b",
      "type": "identify",
      "question_html": "Identify the parent function and find the x-intercepts: \\( f(x) = 5(x + 1)^2 - 80 \\)",
      "inputs": [
        {
          "id": "q1_parent",
          "type": "dropdown",
          "label": "Parent function",
          "options": [
            "quadratic",
            "cubic",
            "absolute value",
            "square root",
            "rational",
            "exponential"
          ],
          "answer": "quadratic"
        },
        {
          "id": "q1_x1",
          "type": "number",
          "label": "x₁ =",
          "answer": 3,
          "tolerance": 0.1
        },
        {
          "id": "q1_x2",
          "type": "number",
          "label": "x₂ =",
          "answer": -5,
          "tolerance": 0.1
        }
      ],
      "plus_minus": true,
      "hint": "Set f(x)=0. Isolate the squared term.",
      "solution_steps": [
        "Parent: y = x² (quadratic — highest power is 2).",
        "Set 0 = 5(x+1)² - 80.",
        "5(x+1)² = 80 → (x+1)² = 16.",
        "x + 1 = ±4 → x = 3 or x = -5."
      ],
      "feedback_correct": "🔥 Parent and intercepts nailed.",
      "feedback_wrong_parent": "Check the exponent for parent type.",
      "feedback_wrong_intercepts": "Parent right. Set f(x)=0 and solve."
    },
    {
      "id": "rp4-q2",
      "number": 2,
      "section": "A",
      "standard": "W2.b",
      "type": "identify",
      "question_html": "Identify the parent function and find the x-intercept: \\( f(x) = \\sqrt{x - 7} - 5 \\)",
      "inputs": [
