      "standard": "S1.a",
      "difficulty": "hard",
      "type": "simplify",
      "question_html": "Simplify. Write your answer in standard form.<br>\\( (3x^3 - 2x^2 + x) + (x^3 + 4x^2 - 5) - (2x^3 - x^2 + 3x - 1) \\)",
      "inputs": [
        {
          "id": "s1q4_ans",
          "type": "text",
          "label": "Answer =",
          "answer": "2x^3 + 3x^2 - 2x - 4",
          "normalize": "poly"
        }
      ],
      "hint": "Handle one operation at a time. Add the first two, then subtract the third. Distribute the negative carefully.",
      "solution_html": "\\( 3x^3 - 2x^2 + x + x^3 + 4x^2 - 5 - 2x^3 + x^2 - 3x + 1 \\)<br>\\( = (3+1-2)x^3 + (-2+4+1)x^2 + (1-3)x + (-5+1) = 2x^3 + 3x^2 - 2x - 4 \\)"
    },
